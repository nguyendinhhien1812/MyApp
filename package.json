{
  "name": "MyApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 8088",
    "ios": "react-native run-ios --port 8088",
    "lint": "eslint .",
    "start": "react-native start --port 8088",
    "test": "jest",
    "miniapp:build": "react-native bundle --platform ios --dev false --entry-file miniapps/loyalty/index.js --config miniapps/loyalty/rspack.config.mjs --bundle-output miniapps/loyalty/build/entry.bundle && rm -f miniapps/loyalty/build/entry.bundle* miniapps/loyalty/build/index.bundle*",
    "miniapp:serve": "npx serve miniapps/loyalty/build -l 9000 --cors",
    "tools:check": "node tools/gen-tool-declarations.mjs --check",
    "tools:gen": "node tools/gen-tool-declarations.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@react-navigation/bottom-tabs": "^6.5.22",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@rneui/base": "^5.0.0",
    "@rneui/themed": "^5.0.0",
    "iconoir-react-native": "^7.9.0",
    "react": "18.2.0",
    "react-hook-form": "^7.80.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "2.16.2",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "3.9.0",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "^3.22.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.0.3",
    "react-native-webview": "^13.10.5",
    "react-redux": "^8.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@callstack/repack": "^5.2.5",
    "@module-federation/enhanced": "0.22.0",
    "@react-native-community/cli": "10.2.0",
    "@react-native-community/cli-platform-android": "10.2.0",
    "@react-native-community/cli-platform-ios": "10.2.0",
    "@react-native/babel-preset": "0.75.3",
    "@react-native/eslint-config": "0.75.3",
    "@react-native/metro-config": "0.75.3",
    "@react-native/typescript-config": "0.75.3",
    "@rspack/core": "^1.7.8",
    "@swc/helpers": "^0.5.19",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.31",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-syntax-hermes-parser": "^0.36.1",
    "eslint": "^8.56.0",
    "hermes-parser": "^0.36.1",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "packageExtensions": {
      "@react-native/codegen": {
        "dependencies": {
          "yargs": "^17.6.2"
        }
      }
    }
  }
