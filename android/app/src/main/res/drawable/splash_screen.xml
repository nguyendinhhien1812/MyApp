<?xml version="1.0" encoding="utf-8"?>
<!--
  Dùng cho Android 11 trở xuống, nơi splash chỉ là windowBackground của theme.
  Android 12+ bỏ qua file này và dùng windowSplashScreen* trong values-v31.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap
            android:src="@drawable/splash_mark"
            android:gravity="center" />
    </item>
</layer-list>
